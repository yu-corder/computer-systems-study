// File name: projects/3/b/RAM4K.hdl
/**
 * Memory of 4K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];

    PARTS:
    //// Replace this comment with your code.

    DMux8Way(in=load, sel=address[9..11], a=loadA, b=loadB, c=loadC, d=loadD, e=loadE, f=loadF, g=loadG, h=loadH);

    RAM512(in=in, address=address[0..8], load=loadA, out=r0);
    RAM512(in=in, address=address[0..8], load=loadB, out=r1);
    RAM512(in=in, address=address[0..8], load=loadC, out=r2);
    RAM512(in=in, address=address[0..8], load=loadD, out=r3);
    RAM512(in=in, address=address[0..8], load=loadE, out=r4);
    RAM512(in=in, address=address[0..8], load=loadF, out=r5);
    RAM512(in=in, address=address[0..8], load=loadG, out=r6);
    RAM512(in=in, address=address[0..8], load=loadH, out=r7);

    Mux8Way16(a=r0, b=r1, c=r2, d=r3, e=r4, f=r5, g=r6, h=r7, sel=address[9..11], out=out);

}